#!/bin/sh
set -e
if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload-rules || true
  udevadm trigger --subsystem-match=hidraw --subsystem-match=input --subsystem-match=misc --action=change || true
fi
if [ "$1" = configure ] && [ -n "$2" ]; then
  sh /usr/lib/glowden/restart-service
fi
echo "GlowDen: start the device service for your user with: systemctl --user enable --now glowdend"
