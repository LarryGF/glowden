{
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Open device hub for Logitech G peripherals",
    "longDescription": "GlowDen configures Logitech G keyboards, mice, headsets and microphones on Linux: lighting, buttons, DPI and microphone settings, kept applied by a background service. Not affiliated with Logitech.",
    "license": "MIT OR Apache-2.0",
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [
          "libpipewire-0.3-0",
          "pipewire-bin",
          "pulseaudio-utils",
          "libdbus-1-3",
          "libsystemd0",
          "curl"
        ],
        "recommends": [
          "libnotify-bin",
          "sqlite3",
          "libayatana-appindicator3-1",
          "xdg-desktop-portal"
        ],
        "desktopTemplate": "../../packaging/linux/glowden.desktop",
        "postInstallScript": "../../packaging/deb/postinst",
        "postRemoveScript": "../../packaging/deb/postrm",
        "files": {
          "/usr/bin/glowdend": "../../target/release/glowdend",
          "/usr/bin/glowdenctl": "../../target/release/glowdenctl",
          "/usr/bin/glowden-sampler": "../../target/release/glowden-sampler",
          "/usr/lib/udev/rules.d/70-glowden.rules": "../../packaging/udev/70-glowden.rules",
          "/usr/lib/systemd/user/glowdend.service": "../../packaging/systemd/glowdend.service",
          "/usr/share/icons/hicolor/256x256/apps/glowden.png": "icons/icon.png",
          "/usr/share/doc/glowden/LICENSE-MIT": "../../LICENSE-MIT",
          "/usr/share/doc/glowden/LICENSE-APACHE": "../../LICENSE-APACHE",
          "/usr/share/doc/glowden/NOTICE.md": "../../NOTICE.md",
          "/usr/share/doc/glowden/README.md": "../../README.md"
        }
      }
    },
    "publisher": "GlowDen contributors"
  }
}
