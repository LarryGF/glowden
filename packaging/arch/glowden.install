post_install() {
  udevadm control --reload-rules
  udevadm trigger --subsystem-match=hidraw --subsystem-match=input --subsystem-match=misc --action=change
  echo "Start the device service for your user with: systemctl --user enable --now glowdend"
}

post_upgrade() {
  post_install
  sh /usr/lib/glowden/restart-service
}
post_remove() { post_install; }
