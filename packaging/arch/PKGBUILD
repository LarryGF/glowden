# Local package: build from this checkout with `makepkg -si` in packaging/arch.
pkgname=glowden
pkgver=0.1.0
pkgrel=1
pkgdesc="GlowDen: open device hub for Logitech G peripherals (lighting, buttons, DPI, microphone)"
arch=('x86_64')
license=('MIT OR Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'pipewire' 'systemd-libs' 'dbus' 'libpulse' 'curl')
optdepends=('libayatana-appindicator: tray icon'
            'libnotify: low-battery and lock-key notifications'
            'sqlite: importing settings from a G HUB settings.db'
            'xdg-desktop-portal: screen sampler lighting effect')
makedepends=('cargo' 'pnpm' 'nodejs')
install=glowden.install
# Rust links the C helpers itself and can't read GCC LTO objects.
options=('!lto')

build() {
  cd "$startdir/../../app"
  pnpm install --frozen-lockfile
  pnpm tauri build
  cd ..
  cargo build --release -p glowden-cli -p glowdend -p glowden-voice -p glowden-sampler
}

package() {
  local root="$startdir/../.."
  install -Dm755 "$root/target/release/glowden" "$pkgdir/usr/bin/glowden"
  install -Dm755 "$root/target/release/glowdenctl" "$pkgdir/usr/bin/glowdenctl"
  install -Dm755 "$root/target/release/glowdend" "$pkgdir/usr/bin/glowdend"
  install -Dm755 "$root/target/release/glowden-voice" "$pkgdir/usr/bin/glowden-voice"
  install -Dm755 "$root/target/release/glowden-sampler" "$pkgdir/usr/bin/glowden-sampler"
  install -Dm644 -t "$pkgdir/usr/share/glowden/drivers" "$root"/drivers/*.toml
  install -Dm644 -t "$pkgdir/usr/share/glowden/drivers/pictures" "$root"/drivers/pictures/*
  install -Dm644 "$root/packaging/udev/70-glowden.rules" "$pkgdir/usr/lib/udev/rules.d/70-glowden.rules"
  install -Dm644 "$root/packaging/systemd/glowdend.service" "$pkgdir/usr/lib/systemd/user/glowdend.service"
  install -Dm644 "$root/packaging/linux/glowden.desktop" "$pkgdir/usr/share/applications/glowden.desktop"
  install -Dm644 "$root/app/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/glowden.png"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$root/LICENSE-MIT" "$root/LICENSE-APACHE"
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" "$root/README.md" "$root/NOTICE.md"
}
