# Local package: build from this checkout with `makepkg -si` in packaging/arch.
pkgname=lhub
pkgver=0.1.0
pkgrel=1
pkgdesc="LHUB: open device hub for Logitech G peripherals (lighting, buttons, DPI, microphone)"
arch=('x86_64')
license=('MIT OR Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'pipewire' 'systemd-libs' 'dbus' 'libpulse' 'curl')
optdepends=('libayatana-appindicator: tray icon'
            'libnotify: low-battery and lock-key notifications'
            'sqlite: importing settings from a G HUB settings.db'
            'xdg-desktop-portal: screen sampler lighting effect')
makedepends=('cargo' 'pnpm' 'nodejs')
install=lhub.install
# Rust links the C helpers itself and can't read GCC LTO objects.
options=('!lto')

build() {
  cd "$startdir/../../app"
  pnpm install --frozen-lockfile
  pnpm tauri build
  cd ..
  cargo build --release -p lhub-cli -p lhubd -p lhub-voice -p lhub-sampler
}

package() {
  local root="$startdir/../.."
  install -Dm755 "$root/target/release/lhub-app" "$pkgdir/usr/bin/lhub-app"
  install -Dm755 "$root/target/release/lhub" "$pkgdir/usr/bin/lhub"
  install -Dm755 "$root/target/release/lhubd" "$pkgdir/usr/bin/lhubd"
  install -Dm755 "$root/target/release/lhub-voice" "$pkgdir/usr/bin/lhub-voice"
  install -Dm755 "$root/target/release/lhub-sampler" "$pkgdir/usr/bin/lhub-sampler"
  install -Dm644 -t "$pkgdir/usr/share/lhub/drivers" "$root"/drivers/*.toml
  install -Dm644 -t "$pkgdir/usr/share/lhub/drivers/pictures" "$root"/drivers/pictures/*
  install -Dm644 "$root/packaging/udev/70-lhub.rules" "$pkgdir/usr/lib/udev/rules.d/70-lhub.rules"
  install -Dm644 "$root/packaging/systemd/lhubd.service" "$pkgdir/usr/lib/systemd/user/lhubd.service"
  install -Dm644 "$root/packaging/linux/lhub.desktop" "$pkgdir/usr/share/applications/lhub.desktop"
  install -Dm644 "$root/app/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/lhub.png"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$root/LICENSE-MIT" "$root/LICENSE-APACHE"
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" "$root/README.md" "$root/NOTICE.md"
}
