{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lhub",
  "version": "0.1.0",
  "identifier": "dev.lhub.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "lhub", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
